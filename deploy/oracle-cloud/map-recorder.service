# MAP V3 recorder (recorder/mapRecorder.mjs): saves the GLD option chain at 08:15 and 16:20
# New York time and serves it on 127.0.0.1:8788 (nginx proxies /maplevels/). The schedule
# follows US daylight saving by itself (Node's built-in time-zone data), whatever the VM's
# own time zone is.
#
# Install (see README.md, "MAP V3 recorder"): replace CANDL_USER and CANDL_REPO, then
#   sudo install -m 0644 deploy/oracle-cloud/map-recorder.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now map-recorder
[Unit]
Description=Candl MAP V3 recorder (GLD option chain snapshots)
After=network-online.target
Wants=network-online.target

[Service]
User=CANDL_USER
WorkingDirectory=CANDL_REPO
ExecStart=/usr/bin/env node recorder/mapRecorder.mjs
Environment=MAP_DIR=/var/lib/candl-map
Environment=MAP_PORT=8788
StateDirectory=candl-map
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
